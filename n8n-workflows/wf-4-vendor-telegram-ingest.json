{
  "id": "wf4-vendor-telegram-ingest",
  "name": "Vendor Telegram Ingest",
  "active": false,
  "nodes": [
    {
      "id": "vendor-telegram-trigger",
      "name": "VendorTelegramTrigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "5mBfLarFM6t8Cgcz",
          "name": "Make-Ready Vendor Telegram Bot"
        }
      }
    },
    {
      "id": "normalize-vendor-telegram",
      "name": "Normalize Vendor Telegram Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "jsCode": "const message = $json.message || $json.edited_message || {};\nconst from = message.from || {}; const chat = message.chat || {};\nconst photos = Array.isArray(message.photo) ? message.photo : [];\nconst photo = photos.length ? photos[photos.length - 1] : null;\nconst voice = message.voice || null; const document = message.document || null;\nlet media = null;\nif (photo) media = { type: 'photo', file_id: photo.file_id || null, mime_type: 'image/jpeg' };\nelse if (voice) media = { type: 'voice', file_id: voice.file_id || null, duration: voice.duration || null };\nelse if (document) media = { type: 'unsupported', file_id: document.file_id || null, mime_type: document.mime_type || null, filename: document.file_name || null };\nreturn [{ json: {\n  channel: 'telegram', sender_ref: String(chat.id || from.id || ''), provider_message_id: String(message.message_id || ''),\n  thread_ref: String(chat.id || ''), in_reply_to: message.reply_to_message ? String(message.reply_to_message.message_id || '') : '',\n  subject: '', text: String(message.text || message.caption || '').trim(), raw_text: String(message.text || message.caption || '').trim(),\n  media, received_at: message.date ? new Date(Number(message.date) * 1000).toISOString() : new Date().toISOString()\n} }];"
      }
    },
    {
      "id": "call-vendor-router-telegram",
      "name": "Call Vendor Message Router",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        560,
        0
      ],
      "parameters": {
        "source": "database",
        "workflowId": "wf4-vendor-router",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "telegram-photo",
      "name": "Telegram Photo Attached?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        840,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "telegram-photo-condition",
              "leftValue": "={{ $('Normalize Vendor Telegram Message').first().json.media?.type === 'photo' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "download-telegram-photo",
      "name": "Download Vendor Telegram Photo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        -100
      ],
      "parameters": {
        "resource": "file",
        "operation": "get",
        "fileId": "={{ $('Normalize Vendor Telegram Message').first().json.media.file_id }}",
        "download": true,
        "additionalFields": {
          "mimeType": "image/jpeg"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "5mBfLarFM6t8Cgcz",
          "name": "Make-Ready Vendor Telegram Bot"
        }
      }
    },
    {
      "id": "prepare-telegram-photo",
      "name": "Prepare Telegram Photo Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        -100
      ],
      "parameters": {
        "jsCode": "const source=$('Normalize Vendor Telegram Message').first().json;let bytes=null;try{bytes=await this.helpers.getBinaryDataBuffer(0,'data');}catch(error){bytes=null;}if(!bytes||bytes.length>5*1024*1024)return[];return[{json:{attachment_upload:{contentType:'image/jpeg',filename:'telegram-'+source.provider_message_id+'.jpg',file:bytes.toString('base64')}}}];"
      }
    },
    {
      "id": "resolve-telegram-attachment",
      "name": "Resolve Telegram Airtable Attachment Records",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1680,
        -100
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT 'AIRTABLE_BASE_ID_PLACEHOLDER'::text base_id,m.airtable_record_id,'Attachments'::text field_name FROM communication_message c JOIN airtable_record_map m ON m.entity_type='communication' AND m.entity_id=c.id WHERE c.channel='telegram' AND c.provider_message_id='{{ String($('Normalize Vendor Telegram Message').first().json.provider_message_id || \"\").replace(/'/g,\"''\") }}'\nUNION ALL SELECT 'AIRTABLE_BASE_ID_PLACEHOLDER',sm.airtable_record_id,'Evidence' FROM communication_message c JOIN airtable_record_map sm ON sm.entity_type='stage' AND sm.entity_id=c.stage_id WHERE c.channel='telegram' AND c.provider_message_id='{{ String($('Normalize Vendor Telegram Message').first().json.provider_message_id || \"\").replace(/'/g,\"''\") }}';",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "cred_make_ready_pg",
          "name": "Make-Ready Postgres"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "build-telegram-attachment",
      "name": "Build Telegram Airtable Attachment Uploads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        -100
      ],
      "parameters": {
        "jsCode": "const upload=$('Prepare Telegram Photo Upload').first().json.attachment_upload;return $input.all().filter(item=>upload&&item.json.airtable_record_id&&!String(item.json.base_id||'').includes('PLACEHOLDER')).map(item=>({json:{...item.json,upload_body:upload,upload_url:'https://content.airtable.com/v0/'+item.json.base_id+'/'+item.json.airtable_record_id+'/'+encodeURIComponent(item.json.field_name)+'/uploadAttachment'}}));"
      }
    },
    {
      "id": "upload-telegram-attachment",
      "name": "Upload Telegram Evidence To Airtable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.upload_url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.upload_body) }}"
      },
      "credentials": {
        "airtableTokenApi": {
          "id": "cred_make_ready_airtable",
          "name": "Make-Ready Airtable"
        }
      }
    }
  ],
  "connections": {
    "VendorTelegramTrigger": {
      "main": [
        [
          {
            "node": "Normalize Vendor Telegram Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Vendor Telegram Message": {
