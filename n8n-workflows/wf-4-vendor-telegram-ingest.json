          }
        ]
      ]
    },
    "Telegram Photo Attached?": {
      "main": [
        [
          {
            "node": "Download Vendor Telegram Photo",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Download Vendor Telegram Photo": {
      "main": [
        [
          {
            "node": "Prepare Telegram Photo Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Telegram Photo Upload": {
      "main": [
        [
          {
            "node": "Resolve Telegram Airtable Attachment Records",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve Telegram Airtable Attachment Records": {
      "main": [
        [
          {
            "node": "Build Telegram Airtable Attachment Uploads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Telegram Airtable Attachment Uploads": {
      "main": [
        [
          {
            "node": "Upload Telegram Evidence To Airtable",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "wf7-error-handler"
  },
  "staticData": null,
  "pinData": {},
  "versionId": "wf4-vendor-telegram--ae-v1",
  "triggerCount": 0,
