      "name": "Resolve Edit Queue",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1560,
        80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH input AS (SELECT '{{ String($json.action||\"\").replace(/'/g,\"''\") }}' action,{{ Number($json.queue_id||0) }}::int queue_id,{{ Number($json.reply_to_message_id||0) }}::bigint reply_id), resolved AS (SELECT q.id FROM outbound_queue q,input i WHERE q.status='editing' AND (q.id=i.queue_id OR (i.queue_id=0 AND (q.manager_message_id=i.reply_id OR i.reply_id=0))) ORDER BY CASE WHEN q.manager_message_id=i.reply_id THEN 0 ELSE 1 END,q.edit_prompted_at DESC NULLS LAST LIMIT 1)\nSELECT '{{ String($json.action||\"\").replace(/'/g,\"''\") }}'::text action,COALESCE(NULLIF({{ Number($json.queue_id||0) }},0),(SELECT id FROM resolved),0) queue_id,{{ Number($json.stage_id||0) }} stage_id,{{ Number($json.turn_id||0) }} turn_id,'{{ String($json.edited_text||\"\").replace(/'/g,\"''\") }}'::text edited_text,'{{ String($json.actor_id||\"manager\").replace(/'/g,\"''\") }}'::text actor_id,'{{ String($json.telegram_chat_id||\"\").replace(/'/g,\"''\") }}'::text telegram_chat_id,'{{ String($json.telegram_callback_query_id||\"\").replace(/'/g,\"''\") }}'::text telegram_callback_query_id;",
        "options": {}
      },
