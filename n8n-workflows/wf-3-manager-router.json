    {
      "id": "parse",
      "name": "Parse Manager Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "jsCode": "const cb=$json.callback_query||null; const msg=$json.message||$json.edited_message||null;\nif(msg){const text=String(msg.text||'').trim();const chat=msg.chat?.id||'';const actor=String(msg.from?.id||'manager');if(text.toLowerCase()==='/health')return[{json:{route:'health',actor_id:actor,channel:'telegram',telegram_chat_id:chat}}];if(text)return[{json:{route:'action',action:'EDIT',queue_id:0,edited_text:text,actor_id:actor,channel:'telegram',telegram_chat_id:chat,reply_to_message_id:Number(msg.reply_to_message?.message_id||0)}}];return[{json:{route:'ignore',telegram_chat_id:chat}}];}\nif(!cb)return[{json:{route:'ignore'}}];const p=String(cb.data||'').split(':');const action=String(p[0]||'').toUpperCase();const id=Number(p[1]||0);const base={actor_id:String(cb.from?.id||'manager'),channel:'telegram',telegram_chat_id:cb.message?.chat?.id||'',telegram_callback_query_id:cb.id};\nif(action==='DONE')return[{json:{...base,route:'complete',stage_id:id}}];if(['SEND','EDIT','HOLD','RETRY_EMAIL','RETRY_TELEGRAM'].includes(action))return[{json:{...base,route:'action',action,queue_id:id}}];if(['SKIP','SNOOZE','CHASE'].includes(action))return[{json:{...base,route:'action',action,stage_id:id}}];if(action==='CANCEL')return[{json:{...base,route:'action',action,turn_id:id}}];return[{json:{...base,route:'ignore'}}];"
      }
    },
    {
      "id": "routes",
      "name": "Determine Manager Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "jsCode": "return [{json:{...$json,is_health:$json.route==='health',is_complete:$json.route==='complete',is_action:$json.route==='action',is_callback:Boolean($json.telegram_callback_query_id)}}];"
      }
    },
