{
  "id": "wf3-manager-router",
  "name": "WF-3 Manager Router",
  "active": false,
  "nodes": [
    {
      "id": "manager-trigger",
      "name": "ManagerTelegramTrigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "jASZWMlrfp3v2tWH",
          "name": "Make-Ready Manager Telegram Bot"
        }
      }
    },
    {
      "id": "parse-manager-callback",
      "name": "Parse Manager Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const callback = $json.callback_query;\nif (!callback) {\n  return [{ json: { handled: false, action: 'ignored', reason: 'No callback query.' } }];\n}\nconst data = String(callback.data || '');\nconst chatId = callback.message && callback.message.chat ? callback.message.chat.id : '';\nconst fromId = callback.from ? callback.from.id : 'manager-telegram';\nif (!data.startsWith('DONE:')) {\n  return [{ json: {\n    handled: false,\n    action: 'noop',\n    telegram_callback_query_id: callback.id,\n    telegram_chat_id: chatId,\n    reason: 'No action taken.'\n  } }];\n}\nreturn [{ json: {\n  handled: true,\n  action: 'done',\n  stage_id: Number(data.slice(5)),\n  actor_id: String(fromId),\n  channel: 'digest',\n  telegram_callback_query_id: callback.id,\n  telegram_chat_id: chatId\n} }];"
      }
    },
    {
      "id": "callback-is-done",
      "name": "Callback Is Done?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "callback-is-done-condition",
              "leftValue": "={{ $json.handled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "call-core-from-digest",
      "name": "Call Completion Core From Digest",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        720,
        -120
      ],
      "parameters": {
        "source": "database",
        "workflowId": "wf3-stage-complete-core",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "answer-callback",
      "name": "Answer Manager Callback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $json.telegram_callback_query_id }}",
        "additionalFields": {
          "text": "={{ $json.manager_response_text || $json.reason || $json.message || \"Done\" }}",
          "show_alert": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "jASZWMlrfp3v2tWH",
          "name": "Make-Ready Manager Telegram Bot"
        }
      }
    },
    {
      "id": "answer-noop",
      "name": "Answer Ignored Callback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        120
      ],
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $json.telegram_callback_query_id }}",
        "additionalFields": {
          "text": "No action taken.",
          "show_alert": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "jASZWMlrfp3v2tWH",
          "name": "Make-Ready Manager Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "ManagerTelegramTrigger": {
      "main": [
        [
          {
            "node": "Parse Manager Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Manager Callback": {
      "main": [
        [
          {
            "node": "Callback Is Done?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Callback Is Done?": {
      "main": [
        [
          {
            "node": "Call Completion Core From Digest",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Answer Ignored Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Completion Core From Digest": {
      "main": [
        [
          {
            "node": "Answer Manager Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {},
