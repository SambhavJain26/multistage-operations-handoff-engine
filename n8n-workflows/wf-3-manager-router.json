    {
      "id": "parse-manager-callback",
      "name": "Parse Manager Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "jsCode": "const callback = $json.callback_query;\nif (!callback) return [{ json: { handled: false, action: 'ignored', reason: 'No callback query.' } }];\nconst data = String(callback.data || '');\nconst chatId = callback.message && callback.message.chat ? callback.message.chat.id : '';\nconst fromId = callback.from ? callback.from.id : 'manager-telegram';\nconst parts = data.split(':');\nconst action = parts[0] || 'NOOP';\nif (action === 'DONE') {\n  return [{ json: { handled: true, route: 'complete', action: 'DONE', stage_id: Number(parts[1] || 0), actor_id: String(fromId), channel: 'digest', telegram_callback_query_id: callback.id, telegram_chat_id: chatId } }];\n}\nif (['SEND', 'HOLD', 'EDIT'].includes(action)) {\n  return [{ json: { handled: true, route: 'action', action, queue_id: Number(parts[1] || 0), actor_id: String(fromId), channel: 'telegram', telegram_callback_query_id: callback.id, telegram_chat_id: chatId } }];\n}\nif (['SKIP', 'SNOOZE'].includes(action)) {\n  return [{ json: { handled: true, route: 'action', action, stage_id: Number(parts[1] || 0), actor_id: String(fromId), channel: 'telegram', telegram_callback_query_id: callback.id, telegram_chat_id: chatId } }];\n}\nif (action === 'CANCEL') {\n  return [{ json: { handled: true, route: 'action', action, turn_id: Number(parts[1] || 0), actor_id: String(fromId), channel: 'telegram', telegram_callback_query_id: callback.id, telegram_chat_id: chatId } }];\n}\nreturn [{ json: { handled: false, action: 'noop', telegram_callback_query_id: callback.id, telegram_chat_id: chatId, reason: 'No action taken.' } }];"
      }
    },
    {
      "id": "callback-handled",
      "name": "Callback Handled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "callback-handled-condition",
              "leftValue": "={{ $json.handled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
