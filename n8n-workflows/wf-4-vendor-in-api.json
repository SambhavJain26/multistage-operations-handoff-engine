      "name": "Normalize Generic Vendor Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "jsCode": "const headers = $json.headers || {}; const query = $json.query || {}; const body = $json.body || {};\nconst configuredToken = 'local-stage-4-vendor-in-token';\nconst suppliedToken = query.token || headers['x-vendor-in-token'] || headers['X-Vendor-In-Token'] || headers['x-demo-token'] || body.token || '';\nconst sender = String(body.sender_ref || query.sender_ref || '').trim(); const text = String(body.text || query.text || '').trim();\nconst mediaType = String(body.media_type || query.media_type || '').trim();\nreturn [{ json: {\n  authorized: Boolean(configuredToken) && String(suppliedToken) === String(configuredToken), valid: Boolean(sender && (text || mediaType)),\n  envelope: { channel: String(body.channel || query.channel || 'generic'), sender_ref: sender,\n    provider_message_id: String(body.provider_message_id || query.provider_message_id || ''), thread_ref: String(body.thread_ref || query.thread_ref || ''),\n    in_reply_to: String(body.in_reply_to || query.in_reply_to || ''), reply_token: String(body.reply_token || query.reply_token || ''),\n    subject: String(body.subject || query.subject || ''), text, raw_text: text,\n    media: mediaType ? { type: mediaType, file_id: String(body.media_file_id || ''), local_path: String(body.media_url || '') } : null,\n    received_at: String(body.received_at || new Date().toISOString()) }\n} }];"
      }
    },
    {
      "id": "generic-authorized",
      "name": "Vendor In Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        560,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "generic-authorized-condition",
              "leftValue": "={{ $json.authorized && $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "unwrap-generic-envelope",
      "name": "Unwrap Generic Envelope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
