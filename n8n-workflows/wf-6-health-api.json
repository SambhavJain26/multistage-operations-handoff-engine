{
  "id": "wf6-health-api",
  "name": "WF-6 Health API",
  "active": true,
  "nodes": [
    {
      "id": "webhook-health",
      "name": "GET Health Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "wf6-health-api",
      "parameters": {
        "httpMethod": "GET",
        "path": "health",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "http://localhost:8080"
        }
      }
    },
    {
      "id": "normalize-health-auth",
      "name": "Normalize Health Auth",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "jsCode": "const headers = $json.headers || {};\nconst query = $json.query || {};\nconst configuredToken = 'local-stage-3-demo-token';\nconst suppliedToken = query.token || headers['x-demo-token'] || headers['X-Demo-Token'] || '';\nreturn [{ json: { authorized: Boolean(configuredToken) && String(suppliedToken) === String(configuredToken), actor_id: 'health-api', channel: 'board', cors_origin: 'http://localhost:8080' } }];"
      }
    },
    {
      "id": "health-authorized",
      "name": "Health Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        560,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "health-authorized-condition",
              "leftValue": "={{ $json.authorized }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "call-health-core",
      "name": "Call Health Core",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        840,
        -120
      ],
      "parameters": {
        "source": "database",
        "workflowId": "wf6-health-core",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "respond-health-ok",
      "name": "Respond Health 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1120,
        -120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "={{ $json.cors_origin || \"http://localhost:8080\" }}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "format-health-unauthorized",
      "name": "Format Health Unauthorized",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        120
      ],
      "parameters": {
        "jsCode": "return [{ json: { accepted: false, outcome: 'unauthorized', error: 'unauthorized', cors_origin: 'http://localhost:8080' } }];"
      }
    },
    {
      "id": "respond-health-unauthorized",
      "name": "Respond Health 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1120,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseCode": 401,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Access-Control-Allow-Origin",
                "value": "={{ $json.cors_origin || \"http://localhost:8080\" }}"
              }
            ]
          }
        }
      }
    }
  ],
  "connections": {
