# Copy this file to .env.production on the client-owned VPS.
# Do not commit .env.production or any real client secrets.

# Client-owned domain and public HTTPS origins
CLIENT_DOMAIN=client.example.com
N8N_HOST=n8n.client.example.com
WEBHOOK_URL=https://n8n.client.example.com
CADDY_ACME_EMAIL=ops@example.com

# Client timezone and retention defaults
GENERIC_TIMEZONE=America/Phoenix
RETENTION_MESSAGE_DAYS=90
RETENTION_PHOTO_DAYS=90
BACKUP_RETENTION_DAYS=30
BACKUP_TARGET=s3://replace-with-client-backup-bucket/make-ready
PRODUCTION_ALERT_EMAIL=ops@example.com

# Reverse-proxy auth and n8n encryption. Generate the Caddy password hash with
# the pinned Caddy image; never store the plaintext password in this file.
CADDY_BASIC_AUTH_USER=replace-with-client-admin-user
CADDY_BASIC_AUTH_HASH=replace-with-caddy-bcrypt-hash
N8N_ENCRYPTION_KEY=replace-with-64-plus-random-characters

# Postgres users and passwords
POSTGRES_PASSWORD=replace-with-strong-postgres-admin-password
N8N_DB_PASSWORD=replace-with-strong-n8n-db-password
MAKE_READY_DB=make_ready_demo
MAKE_READY_DB_USER=make_ready_demo
MAKE_READY_DB_PASSWORD=replace-with-strong-app-db-password

# Production integration token. This protects the channel-independent vendor webhook.
VENDOR_IN_DEMO_TOKEN=replace-with-strong-vendor-in-token

# Airtable and vendor mailbox identifiers. Store PAT and mailbox passwords only in
# named n8n credentials, never in this file.
AIRTABLE_WORKSPACE_ID=replace-with-client-airtable-workspace-id
AIRTABLE_BASE_ID=replace-with-client-airtable-base-id
VENDOR_EMAIL_FROM=make-ready@client.example.com
VENDOR_EMAIL_REPLY_TO=make-ready@client.example.com

# Stage 7/error alert routing. Use client-approved operational recipients only.
BUILDER_TELEGRAM_CHAT_ID=replace-with-builder-or-ops-chat-id
MANAGER_TELEGRAM_CHAT_ID=replace-with-manager-chat-id-if-telegram-remains-enabled

# SMS is design-only in Stage 8. Keep disabled until 10DLC, consent, legal review,
# client-approved templates, and STOP handling are complete.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=replace-after-client-twilio-account-exists
TWILIO_AUTH_TOKEN=replace-after-client-twilio-account-exists
TWILIO_MESSAGING_SERVICE_SID=replace-after-approved-a2p-campaign
TWILIO_FROM_NUMBER=replace-after-approved-a2p-campaign
TWILIO_PRIVACY_POLICY_URL=https://client.example.com/privacy
TWILIO_TERMS_URL=https://client.example.com/terms
