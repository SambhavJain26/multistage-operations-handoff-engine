# Copy this file to .env for local development. Do not commit .env.

# n8n editor auth
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Generate a durable local value before first n8n startup:
# powershell -NoProfile -Command "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
N8N_ENCRYPTION_KEY=replace-with-64-plus-random-characters

# Local Postgres admin and app users
POSTGRES_PASSWORD=change-me
N8N_DB_PASSWORD=change-me
MAKE_READY_DB=make_ready_demo
MAKE_READY_DB_USER=make_ready_demo
MAKE_READY_DB_PASSWORD=change-me

# Local-first defaults. Replace WEBHOOK_URL with the active HTTPS tunnel URL
# only while testing Telegram Trigger workflows.
GENERIC_TIMEZONE=America/Phoenix
WEBHOOK_URL=http://localhost:5678

# Manager and builder Telegram controls
MANAGER_TELEGRAM_CHAT_ID=
BUILDER_TELEGRAM_CHAT_ID=

# Stage 4 inbound demo controls
VENDOR_IN_DEMO_TOKEN=local-stage-4-vendor-in-token
VENDOR_TELEGRAM_CHAT_ID=
RIVERA_TELEGRAM_CHAT_ID=
MARIAS_TELEGRAM_CHAT_ID=
DALE_TELEGRAM_CHAT_ID=
STATEWIDE_TELEGRAM_CHAT_ID=
QUICKHAUL_TELEGRAM_CHAT_ID=

# Airtable manager workspace. The setup script writes the real IDs to an
# ignored local manifest; these placeholders support production templates.
AIRTABLE_WORKSPACE_ID=
AIRTABLE_BASE_ID=

# Vendor email uses n8n credentials named Make-Ready Vendor Email IMAP and
# Make-Ready Vendor Email SMTP. Keep mailbox passwords out of this file.
VENDOR_EMAIL_FROM=make-ready@example.com
VENDOR_EMAIL_REPLY_TO=make-ready@example.com
RIVERA_VENDOR_EMAIL=rivera@example.com
MARIAS_VENDOR_EMAIL=marias@example.com
DALE_VENDOR_EMAIL=dale@example.com
STATEWIDE_VENDOR_EMAIL=statewide@example.com
QUICKHAUL_VENDOR_EMAIL=quickhaul@example.com

# Record resolved OpenAI model IDs here after scripts/openai-model-check.ps1.
OPENAI_MODEL_CLASSIFY=gpt-5.6-luna
OPENAI_MODEL_DRAFT=gpt-5.6-luna
